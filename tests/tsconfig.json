{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node", "aws-lambda", "jest"]
  },
  "include": ["**/*", "../src/**/*"],
  "exclude": ["../node_modules", "../dist"]
}
