{
  "name": "emobility-backend",
  "version": "1.0.0",
  "description": "E-Mobility Backend Lambda Functions",
  "scripts": {
    "format": "prettier --write .",
    "build": "tsc",
    "clean": "bash ./scripts/clean.sh",
    "lint": "eslint src",
    "lint:fix": "eslint . --fix",
    "test:unit": "jest --config jest.unit.config.js --verbose",
    "test:unit:watch": "jest --config jest.unit.config.js --watch",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --config jest.integration.config.js --verbose",
    "test:integration:watch": "node --experimental-vm-modules node_modules/.bin/jest --config jest.integration.config.js --watch",
    "package": "yarn clean && yarn build && bash ./scripts/package.sh",
    "generate:token": "ts-node scripts/generate-ocpi-token.ts",
    "hash:token": "ts-node scripts/hash-ocpi-token.ts"
  },
  "license": "EUPL-1.2",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1125.0",
    "@aws-sdk/client-lambda": "^3.1125.0",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/client-secrets-manager": "^3.1125.0",
    "@aws-sdk/client-sqs": "^3.1125.0",
    "@aws-sdk/client-sts": "^3.1125.0",
    "@aws-sdk/lib-dynamodb": "^3.1125.0",
    "@aws-sdk/util-dynamodb": "^3.996.9"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.x.x",
    "yarn": ">=1.0.0"
  },
  "overrides": {
    "fast-xml-parser": ">=5.5.7"
  }
}
